# Provisioned by Vercel Marketplace (pull with `vercel env pull .env.local --yes`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
KV_REST_API_URL=
KV_REST_API_TOKEN=

# AI Gateway (OIDC via VERCEL_OIDC_TOKEN locally, automatic on Vercel)
AI_TEXT_MODEL=anthropic/claude-sonnet-5.5
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=

# Email alerts
RESEND_API_KEY=
ALERTS_FROM_EMAIL=Allochemix Alerts <alerts@example.com>

# Cron + app
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLATFORM_ADMIN_USER_IDS=
NEXT_PUBLIC_SALES_EMAIL=sales@allochemix.com

# EPA data sources
EPA_CCTE_API_KEY=
TSCA_INVENTORY_URL=https://www.epa.gov/system/files/other-files/2026-05/csv-non-cbi-tsca-inventory.zip
# Optional override; defaults to EPA's Safer Ingredients page
SCIL_CSV_URL=
REGLIST_SARA313_URL=
REGLIST_CERCLA_URL=
REGLIST_HAP_URL=
REGLIST_PROP65_URL=
REGLIST_RCRA_URL=
# Optional overrides; both default to the public EPA ChemExpo bulk downloads.
REGLIST_PEST_INERT_URL=
CHEMEXPO_COMPOSITION_URL=

# Licensed SDS + supplier feed
SDS_PROVIDER=generic-rest
SDS_PROVIDER_BASE_URL=
SDS_PROVIDER_API_KEY=
SDS_PROVIDER_ID=licensed
